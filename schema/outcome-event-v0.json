{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theagentbureau.xyz/schemas/outcome-event-v0.json",
  "title": "Agent Bureau outcome event v0",
  "description": "One outcome a furnisher reports about an agent. Payment outcomes need an amount; payment_failed, not_delivered, access_revoked and policy_violation need evidence. The signature is Ed25519 over the canonical form described in the agent-bureau-furnish README.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0"
        },
        "furnisher_id": {
          "type": "string",
          "pattern": "^fur_[a-z0-9]{6,32}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "subject_ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "chain": {
                  "type": "string",
                  "enum": [
                    "arc",
                    "base",
                    "bnb",
                    "robinhood",
                    "solana"
                  ]
                },
                "registry": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "chain",
                "registry",
                "id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "wallet": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{40}$"
                    },
                    {
                      "type": "string",
                      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
                    }
                  ]
                }
              },
              "required": [
                "wallet"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "did": {
                  "type": "string",
                  "maxLength": 256,
                  "pattern": "^did:[a-z0-9]+:\\S+$"
                }
              },
              "required": [
                "did"
              ],
              "additionalProperties": false
            }
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "signature": {
          "type": "string",
          "pattern": "^ed25519:[A-Za-z0-9_-]{86}$"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "paid",
            "refunded"
          ]
        },
        "amount": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "asset": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16
            },
            "chain": {
              "type": "string",
              "pattern": "^[a-z0-9-]{2,32}$"
            }
          },
          "required": [
            "value",
            "asset",
            "chain"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "properties": {
            "tx_hash": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "counteraudit_packet": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "log_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "required": [
        "schema_version",
        "furnisher_id",
        "event_id",
        "subject_ref",
        "occurred_at",
        "signature",
        "outcome",
        "amount"
      ],
      "additionalProperties": false
    },
